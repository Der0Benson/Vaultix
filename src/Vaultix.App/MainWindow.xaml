<Window x:Class="Vaultix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vaultix.App"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Vaultix" Icon="Assets/vaultix.ico" Height="820" Width="1320" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Margin" Value="0,3" /><Setter Property="Padding" Value="16,11" /><Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="22" /><Setter Property="Margin" Value="0,0,14,14" /></Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Width" Value="238" /><Setter Property="MinHeight" Value="112" /></Style>
        <Style x:Key="ChartPanel" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" /><Setter Property="BorderBrush" Value="#202A3A" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="13" /><Setter Property="Padding" Value="12,12,16,8" /></Style>
        <Style x:Key="MicroLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="Pill" TargetType="Border"><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10,5" /><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /></Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="2,0"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#364258" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" /><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" /><Setter Property="ScrollViewer.CanContentScroll" Value="True" /></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="0,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="226" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E121A" BorderBrush="#202735" BorderThickness="0,0,1,0">
            <Grid Margin="18,22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,30"><Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentBrush}"><TextBlock Text="V" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Vaultix" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" /></StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Übersicht" Content="⌂   Übersicht" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Backup" Content="▣   Backup" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Snapshots" Content="◫   Snapshots &amp; Restore" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Aktivität" Content="≋   Aktivität" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Statistik" Content="⌁   Statistik" />
                </StackPanel>
                <Button Grid.Row="2" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Einstellungen" Content="⚙   Einstellungen" />
            </Grid>
        </Border>

        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="#202735" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid><TextBlock Text="{Binding SelectedPage}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="15" Padding="12,6"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource SubtleTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ServerOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ServerLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" /></StackPanel></Border></Grid>
            </Border>
            <Grid Grid.Row="1" Margin="30,26,20,20">
                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Übersicht"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Style="{StaticResource Card}" Padding="30" Background="{StaticResource HeroBrush}" BorderBrush="#3B356B">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top"><TextBlock Text="◆" Foreground="{StaticResource AccentBrightBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" Margin="18,0,28,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding HeroTitle}" FontSize="29" FontWeight="SemiBold" /><Border Style="{StaticResource Pill}" Margin="14,2,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding PhaseLabel}" Foreground="{StaticResource AccentBrightBrush}" FontSize="11" FontWeight="SemiBold" /></Border></StackPanel>
                                    <TextBlock Text="{Binding ServiceState}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding CurrentFile}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="650" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Backup jetzt starten" Command="{Binding BackupNowCommand}" VerticalAlignment="Center" Padding="20,11" />
                            </Grid>
                        </Border>
                        <WrapPanel>
                            <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BACKUP HEALTH" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding HealthLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ServerOnline}" Value="False"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding HasFailures}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><Border Grid.Column="1" Width="36" Height="36" CornerRadius="11" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ServerOnline}" Value="False"><Setter Property="Background" Value="#3A3020" /></DataTrigger><DataTrigger Binding="{Binding HasFailures}" Value="True"><Setter Property="Background" Value="#402128" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="✓" /><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ServerOnline}" Value="False"><Setter Property="Text" Value="•" /><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger><DataTrigger Binding="{Binding HasFailures}" Value="True"><Setter Property="Text" Value="!" /><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid></Border>
                            <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LETZTES BACKUP" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding LastBackupLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel><Border Grid.Column="1" Width="36" Height="36" CornerRadius="11" Background="{StaticResource BlueSoftBrush}" VerticalAlignment="Top"><TextBlock Text="◷" Foreground="{StaticResource BlueBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
                            <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GESCHÜTZTE DATEIEN" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding ProtectedFilesLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0" /></StackPanel><Border Grid.Column="1" Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top"><TextBlock Text="▤" Foreground="{StaticResource AccentBrightBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
                            <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LOGISCH GESICHERT" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding ProtectedBytesLabel}" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0" /></StackPanel><Border Grid.Column="1" Width="36" Height="36" CornerRadius="11" Background="#2B2649" VerticalAlignment="Top"><TextBlock Text="⬡" Foreground="{StaticResource AccentBrightBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
                        </WrapPanel>
                        <Border Style="{StaticResource Card}" Padding="24">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="286" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Margin="2,0,2,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Transfer" FontSize="20" FontWeight="SemiBold" /><Border Margin="12,0,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Pill}"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ServerOnline}" Value="False"><Setter Property="Background" Value="#3A3020" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ServerOnline}" Value="False"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding GraphBadgeLabel}" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ServerOnline}" Value="False"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border></StackPanel><TextBlock Text="Vaultix-Netzwerkverkehr · letzte 5 Minuten" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="30,0,26,0"><TextBlock Text="↑  UPLOAD" Style="{StaticResource MicroLabel}" Foreground="{StaticResource AccentBrightBrush}" /><TextBlock Text="{Binding UploadSpeedLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="↓  DOWNLOAD" Style="{StaticResource MicroLabel}" Foreground="{StaticResource SuccessBrush}" /><TextBlock Text="{Binding DownloadSpeedLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Style="{StaticResource ChartPanel}">
                                    <Grid>
                                        <lvc:CartesianChart Background="Transparent" Series="{Binding TransferSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Hidden" AnimationsSpeed="0:0:0.3" TooltipPosition="Top" TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}" TooltipTextPaint="{Binding TooltipTextPaint}" />
                                        <Border Background="#D90D131E" CornerRadius="10" Padding="13,7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"><TextBlock Text="{Binding GraphStatusLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Border>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" Margin="2,20,2,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="FORTSCHRITT" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding ProgressLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" /><ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" Width="112" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BorderSoftBrush}" Margin="0,3" />
                                    <StackPanel Grid.Column="2" Margin="20,0"><TextBlock Text="RESTZEIT" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding EtaLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding SessionDurationLabel, StringFormat=Läuft seit {0}}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                    <Border Grid.Column="3" Background="{StaticResource BorderSoftBrush}" Margin="0,3" />
                                    <StackPanel Grid.Column="4" Margin="20,0"><TextBlock Text="DATEIEN" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding FileProgressLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding FilesPerSecondLabel}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                    <Border Grid.Column="5" Background="{StaticResource BorderSoftBrush}" Margin="0,3" />
                                    <StackPanel Grid.Column="6" Margin="20,0"><TextBlock Text="DURCHSCHNITT" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding AverageUploadLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding PeakUploadLabel, StringFormat=Peak {0}}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                    <Border Grid.Column="7" Background="{StaticResource BorderSoftBrush}" Margin="0,3" />
                                    <StackPanel Grid.Column="8" Margin="20,0,0,0"><TextBlock Text="SESSION" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding SessionTrafficLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="{Binding ByteProgressLabel}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <WrapPanel>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="NÄCHSTER ABGLEICH" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding NextReconciliationLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="Kontrollscan" Foreground="{StaticResource SubtleTextBrush}" Margin="0,5,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="NÄCHSTER SNAPSHOT" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding NextSnapshotLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="Wiederherstellungspunkt" Foreground="{StaticResource SubtleTextBrush}" Margin="0,5,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="WARTESCHLANGE" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding PendingLabel}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="Änderungen warten" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="LETZTE PRÜFUNG" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding LastBackupLabel}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="Erfolgreich geschützt" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" /></StackPanel></Border>
                        </WrapPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Backup-Aktivität" FontSize="17" FontWeight="SemiBold" /><ProgressBar Height="6" Margin="0,20,0,10" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#272D39" /><TextBlock Text="{Binding PendingLabel, StringFormat={}{0} Dateien warten}" Foreground="{StaticResource MutedBrush}" /><ItemsControl ItemsSource="{Binding Activities}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" /><TextBlock Grid.Column="1" Text="{Binding TimestampUtc, StringFormat={}{0:HH:mm}}" Foreground="{StaticResource MutedBrush}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Server" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding ServerLabel}" FontSize="26" FontWeight="SemiBold" Margin="0,22,0,2" /><TextBlock Text="{Binding ServerUrl}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" /><Separator Margin="0,22" Background="#303746" /><TextBlock Text="Warteschlange" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding PendingLabel}" FontSize="22" Margin="0,5,0,0" /></StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Backup"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,10,18"><TextBlock Text="Geschützte Ordner" FontSize="28" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryButton}" Content="Entfernen" Command="{Binding RemoveFolderCommand}" Margin="0,0,10,0" /><Button Content="+ Ordner hinzufügen" Command="{Binding AddFolderCommand}" /></StackPanel></Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Path}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="Kontinuierlicher Schutz" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Schedule}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="2" Text="{Binding LastSuccessfulBackupUtc, StringFormat={}{0:g}}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Snapshots"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Snapshots" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18" /><ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding SourceRoot}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding CreatedUtc, StringFormat={}{0:g}}" /><TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} Dateien}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,50,14,14" VerticalAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Datei wiederherstellen" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Wähle eine Datei aus dem markierten Snapshot." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding SnapshotFiles}" SelectedItem="{Binding SelectedSnapshotFile}"><ListBox.ItemTemplate><DataTemplate><Border Background="#0D111A" CornerRadius="8" Padding="11" Margin="0,2"><StackPanel><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Size, StringFormat={}{0:N0} Bytes}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2"><TextBlock Text="{Binding RestoreRelativePath}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" /><Button Content="Wiederherstellen…" Command="{Binding RestoreCommand}" Margin="0,12,0,0" /></StackPanel></Grid></Border>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Aktivität"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <StackPanel><TextBlock Text="Aktivität" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18" /><ListBox ItemsSource="{Binding Activities}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" /><TextBlock Grid.Column="1" Text="{Binding Message}" /><TextBlock Grid.Column="2" Text="{Binding TimestampUtc, StringFormat={}{0:g}}" Foreground="{StaticResource MutedBrush}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Statistik"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Text="Performance &amp; Effizienz" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Echte Daten aus den letzten Backup-Sitzungen" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,7,0,0" /></StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="255" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Backup-Volumen" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Logische Daten pro abgeschlossener Sitzung" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel><Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="LETZTE 12" Foreground="{StaticResource AccentBrightBrush}" FontSize="10" FontWeight="Bold" /></Border></Grid><Border Grid.Row="1" Style="{StaticResource ChartPanel}" Margin="0,18,0,0"><lvc:CartesianChart Background="Transparent" Series="{Binding BackupHistorySeries}" XAxes="{Binding HistoryXAxes}" YAxes="{Binding HistoryYAxes}" LegendPosition="Hidden" AnimationsSpeed="0:0:0.45" TooltipPosition="Top" TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}" TooltipTextPaint="{Binding TooltipTextPaint}" /></Border></Grid></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource SuccessSoftBrush}"><TextBlock Text="◇" Foreground="{StaticResource SuccessBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Deduplizierung" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Speichereffizienz" Foreground="{StaticResource MutedBrush}" FontSize="12" /></StackPanel></StackPanel><TextBlock Text="{Binding DedupeRatioLabel}" FontSize="34" FontWeight="SemiBold" Margin="0,25,0,0" /><ProgressBar Maximum="1" Value="{Binding DedupeRatio, Mode=OneWay}" Margin="0,10,0,20" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="EINGESPART" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding DeduplicatedLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ÜBERTRAGEN" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding UploadedHistoryLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Grid><TextBlock Text="Identische Inhalte werden nur einmal physisch gespeichert." Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,22,0,0" /></StackPanel></Border>
                        </Grid>
                        <Grid Margin="2,10,16,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="130" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><TextBlock Text="LETZTE BACKUP-SITZUNGEN" Style="{StaticResource MicroLabel}" /><TextBlock Grid.Column="1" Text="DATEIEN" Style="{StaticResource MicroLabel}" /><TextBlock Grid.Column="2" Text="LOGISCH" Style="{StaticResource MicroLabel}" /><TextBlock Grid.Column="3" Text="ÜBERTRAGEN" Style="{StaticResource MicroLabel}" /><TextBlock Grid.Column="4" Text="DEDUPLIZIERT" Style="{StaticResource MicroLabel}" /></Grid>
                        <ListBox ItemsSource="{Binding RecentSessions}" MaxHeight="430"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="130" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StartedUtc, StringFormat={}{0:g}}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding FilesProcessed, StringFormat={}{0:N0}}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding BytesLogical, StringFormat={}{0:N0} B}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="3" Text="{Binding BytesUploaded, StringFormat={}{0:N0} B}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding BytesDeduplicated, StringFormat={}{0:N0} B}" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                    </StackPanel></ScrollViewer>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Einstellungen"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Einstellungen" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18" /><Border Style="{StaticResource Card}" Width="700"><StackPanel><TextBlock Text="Vaultix Server" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Im Heimnetz HTTPS verwenden; HTTP ist nur für localhost erlaubt." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18" /><TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" /><Button Content="Verbinden und Gerät koppeln" Command="{Binding ConnectServerCommand}" HorizontalAlignment="Left" Margin="0,15,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}" Width="700"><StackPanel><TextBlock Text="Kontinuierlicher Schutz" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="Dateiänderungen automatisch sichern" IsChecked="{Binding ContinuousProtection}" Foreground="{StaticResource TextBrush}" Margin="0,16,0,10" /><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><TextBlock Text="Ruhezeit nach Änderungen (Sekunden)" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding DebounceOptions}" SelectedItem="{Binding DebounceSeconds}" /></Grid><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><TextBlock Text="Vollständiger Abgleich (Minuten)" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ReconciliationOptions}" SelectedItem="{Binding ReconciliationMinutes}" /></Grid><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><TextBlock Text="Sichtbarer Snapshot (Minuten)" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding SnapshotOptions}" SelectedItem="{Binding SnapshotMinutes}" /></Grid><CheckBox Content="Leere Snapshots überspringen" IsChecked="{Binding SkipUnchangedSnapshots}" Foreground="{StaticResource TextBrush}" Margin="0,10" /><Button Content="Schutzeinstellungen speichern" Command="{Binding SaveProtectionSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}" Width="700"><StackPanel><TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12" /><StackPanel Orientation="Horizontal"><Button Content="Jetzt prüfen" Command="{Binding CheckForUpdatesCommand}" /><Button Content="Update installieren" Command="{Binding InstallUpdateCommand}" Margin="10,0,0,0" /></StackPanel><TextBlock Text="Bei der Installation erscheint die Windows-Sicherheitsabfrage; Vaultix startet danach neu." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}" Width="700"><StackPanel><TextBlock Text="Desktop" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="Vaultix mit Windows starten und im Tray öffnen" IsChecked="{Binding StartupEnabled}" Foreground="{StaticResource TextBrush}" Margin="0,18,0,4" /><TextBlock Text="Der Vaultix Service läuft unabhängig von diesem Fenster weiter." Foreground="{StaticResource MutedBrush}" /></StackPanel></Border><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="4,8" /></StackPanel></ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
