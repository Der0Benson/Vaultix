[Unit]
Description=Vaultix Server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=vaultix
Group=vaultix
WorkingDirectory=/opt/vaultix/server
ExecStart=/usr/bin/dotnet /opt/vaultix/server/Vaultix.Server.dll
Environment=VAULTIX_REPOSITORY=/var/lib/vaultix
EnvironmentFile=-/etc/vaultix/server.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vaultix

[Install]
WantedBy=multi-user.target
