FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Vaultix.Server/Vaultix.Server.csproj -c Release -o /out --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
ENV VAULTIX_REPOSITORY=/var/lib/vaultix
VOLUME ["/var/lib/vaultix"]
EXPOSE 8080
USER 1654
ENTRYPOINT ["dotnet", "Vaultix.Server.dll"]
