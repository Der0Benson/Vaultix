# Published locally by default. A TLS reverse proxy may forward to this port.
VAULTIX_HTTP_PORT=7443

# The LAN IP address or DNS name that the Windows client uses to reach this server.
VAULTIX_TLS_HOST=192.168.178.20
VAULTIX_HTTPS_PORT=443

# Set to true only while pairing a new Windows device, then set it back to false.
VAULTIX_PAIRING_ENABLED=false
